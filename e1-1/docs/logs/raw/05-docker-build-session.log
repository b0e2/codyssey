FROM ubuntu:22.04

WORKDIR /app

RUN apt-get update && \
    apt-get install -y python3 python3-pip && \
    rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip3 install --no-cache-dir -r requirements.txt

RUN useradd --create-home appuser

COPY main.py .

ENV PORT=8000
ENV APP_ENV=production

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=3s \
  CMD python3 -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

USER appuser

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"][1m[7m%[27m[1m[0m                                                              [0m[27m[24m[Jbeenjeong022655@c5r4s7 app % [K[?2004h[7mdocker build -t my-web:1.0 .[27m[28D[27md[27mo[27mc[27mk[27me[27mr[27m [27mb[27mu[27mi[27ml[27md[27m [27m-[27mt[27m [27mm[27my[27m-[27mw[27me[27mb[27m:[27m1[27m.[27m0[27m [27m.[?2004l
